# Copy this file to .env and fill in real values.
PORT=3001

# Password gate for the whole dashboard, and the secret used to sign session cookies.
# Generate each with: openssl rand -base64 24
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Set to "true" only if the dashboard is served over real HTTPS (not needed for
# plain Tailscale access, since that's already encrypted at the network layer).
COOKIE_SECURE=false

# From Google Cloud Console > APIs & Services > Credentials
# (see root README.md for the step-by-step setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth-callback

# Where the frontend runs, so the OAuth callback knows where to send you back
FRONTEND_URL=http://localhost:5173

# Apple Calendar (iCloud), via CalDAV. Use an app-specific password, NOT your
# real Apple ID password (see root README.md for the step-by-step setup).
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Azure service principal for read-only access to Container Apps Jobs
# (az ad sp create-for-rbac, scoped to the resource group below).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# To show spend in the Azure Jobs tab, also grant the service principal the
# "Cost Management Reader" role on the whole subscription (not just the
# resource group above — spend can span multiple resource groups, e.g. the
# container registry or storage account):
#   az role assignment create --assignee <AZURE_CLIENT_ID> \
#     --role "Cost Management Reader" \
#     --scope /subscriptions/<AZURE_SUBSCRIPTION_ID>
#
# For credit-based subscriptions (e.g. Azure for Students' one-time credit,
# which isn't billed and just runs out), set AZURE_CREDIT_START_DATE to when
# the credit period began (YYYY-MM-DD) to track remaining balance instead of
# a recurring budget. Defaults: 100 (in your billing currency) over 12 months.
AZURE_CREDIT_START_DATE=
AZURE_CREDIT_AMOUNT=100
AZURE_CREDIT_MONTHS=12

# ACR admin credentials, used as the registry secret when deploying new
# Container Apps Jobs from the dashboard (az acr credential show --name <registry>)
ACR_SERVER=
ACR_USERNAME=
ACR_PASSWORD=

# Personal access token (repo + workflow scopes) used to trigger the agent
# build-and-push GitHub Actions workflow from the dashboard.
GITHUB_TOKEN=

# Gmail app password used by deployed agents that need to send email
# (e.g. the morning wake-up agent), and now also used directly by the
# dashboard backend (over IMAP) to create a Gmail draft when an outreach
# draft is approved. Approve never sends on its own - it only appends a
# draft to [Gmail]/Drafts for a human to review and send.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Azure Table Storage holding outreach agent state (candidate/qualified
# companies, pending_review drafts, sent/rejected history).
# (az storage account create ... ; az storage account show-connection-string ...)
AZURE_STORAGE_CONNECTION_STRING=

# Anthropic API key used by the lead-gen agent job to qualify candidate
# companies against the Fluia ICP and draft personalized outreach.
# (console.anthropic.com)
ANTHROPIC_API_KEY=

# Apollo.io API key used by the lead-gen agent job for firmographic company
# search and contact enrichment (Apollo Settings > Integrations > API).
APOLLO_API_KEY=

# Absolute path to the local outreach-agent checkout (../outreach/outreach-agent
# relative to this repo's parent). Lets the Outreach tab's "Sync local agent"
# button run its tools/sync_to_dash.py to push/pull drafts. Leave blank to
# hide the button.
OUTREACH_AGENT_DIR=
